#!/usr/bin/env bash
# Refuse to push when the Parquet export does not match the raw files.
#
# Installed by scripts/install_hooks.sh. Runs make verify, which restores
# data/raw if needed, rebuilds the export and checks it against the raw files
# (counts, totals, a sample of rows field by field), and checks the README for
# figures. It exists because a mismatch once reached the remote that make
# verify would have caught before the push.
#
# Skip deliberately with: git push --no-verify

set -uo pipefail
cd "$(git rev-parse --show-toplevel)" || exit 1
export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:$PATH"

printf 'pre-push: checking the Parquet export against the raw files (make verify)... '
if out=$(make verify 2>&1); then
  echo "ok"
  exit 0
fi
echo "FAILED"
echo "$out" | grep -E "^  FAIL" | head -20
echo
echo "make verify failed: the Parquet export does not match the raw files it is built from."
echo "Fix it, or push with --no-verify if the mismatch is deliberate."
exit 1
