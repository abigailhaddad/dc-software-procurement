# Secrets
.env

# Pulled data and caches. Regenerate with: make pull
#
# The rule is what it costs to rebuild, not what kind of file it is. Anything
# recoverable by re-downloading is ignored; anything that cost model calls is
# tracked, so a fresh checkout does not have to pay for it again. That is why
# data/pdftext/ is here and data/ratecache/, data/pdftext_ocr/ and
# data/classifications.json are tracked.
data/raw/
data/pdftext/
data/pdf/
data/h1b/raw/

# Python
__pycache__/
*.pyc
.venv/
.ipynb_checkpoints/
data/h1b/dol/raw/

# Intermediate dumps the solicitations scripts write for inspection. The
# CSVs beside them are the chain's actual inputs and are tracked.
data/solicitations/_*.json
.playwright-mcp/

# Frozen snapshot the published briefing was computed from.
data/raw_baseline_*/

# Weekly drift reports (analysis/drift_report.py). Derived from the data/raw
# snapshot, which is not tracked either, so a report cannot be reproduced from
# this repo alone; the published figures it reports against are in
# analysis/verify_claims.py, which is.
data/drift/

.DS_Store

# Weekly run logs (scripts/weekly_refresh.sh).
data/logs/
.wrangler/
data/review_leads/leads.csv

# Agent worktrees.
.claude/worktrees/
